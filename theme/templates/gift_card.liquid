{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money }}</title>

    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}

    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: linear-gradient(45deg, #0e0b2f 4%, #302b63 46%, #24243e 94%);
        background-attachment: fixed;
        color: #FFFFFF;
        text-align: center;
        padding: 40px 20px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .giftcard-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: rgba(23, 21, 48, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 2px solid #00F0FF;
        box-shadow: 0 4px 20px rgba(0, 240, 255, 0.15);
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .giftcard-header__inner {
        width: 100%;
        max-width: 1280px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .giftcard-header__logo {
        font-family: inherit;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #FFFFFF;
        text-decoration: none;
      }
      .giftcard-header__logo span {
        color: #00F0FF;
      }
      .giftcard {
        background-color: rgba(23, 21, 48, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        max-width: 500px;
        margin: 100px auto 40px;
        padding: 30px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }
      h1 {
        color: #00FF94;
        font-size: 24px;
        margin-bottom: 10px;
      }
      .code {
        font-family: monospace;
        font-size: 20px;
        background: #0A0A0A;
        padding: 10px 20px;
        border: 1px dashed #00FF94;
        display: inline-block;
        margin: 20px 0;
        letter-spacing: 2px;
        color: #00FF94;
      }
    </style>
  </head>
  <body>
    <header class="giftcard-header">
      <div class="giftcard-header__inner">
        <a href="/" class="giftcard-header__logo">
          <span>Tactile</span> Lab
        </a>
      </div>
    </header>

    <div class="giftcard">
      <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>
      <h2>{{ gift_card.initial_value | money }}</h2>

      <div class="code">
        {{ gift_card.code | format_code }}
      </div>

      <p>Use this code at checkout to redeem your gift card.</p>
    </div>
  </body>
</html>
