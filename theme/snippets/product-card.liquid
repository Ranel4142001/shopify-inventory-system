{% comment %}
  Renders a product card
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

<article class="product-card" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="product-card__link">

    <!-- Image -->
    <div class="product-card__image-wrapper">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image"
          loading="lazy"
          width="600"
          height="600"
        >
      {% else %}
        <div class="product-card__image-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
        </div>
      {% endif %}

      <!-- Badges -->
      <div class="product-card__badges">
        {% if product.tags contains 'group-buy' %}
          <span class="badge badge--group-buy">
            {{ 'products.group_buy_badge' | t }}
          </span>
        {% endif %}
        {% if product.tags contains 'new' %}
          <span class="badge badge--new">
            {{ 'products.new_badge' | t }}
          </span>
        {% endif %}
        {% if product.compare_at_price > product.price %}
          <span class="badge badge--sale">
            {{ 'products.sale_badge' | t }}
          </span>
        {% endif %}
      </div>
    </div>

    <!-- Info -->
    <div class="product-card__info">
      <p class="product-card__vendor">{{ product.vendor }}</p>
      <h3 class="product-card__title">{{ product.title }}</h3>

      <!-- Price -->
      {% render 'price', product: product %}

      <!-- Tags preview -->
      {% if product.tags contains 'linear'
        or product.tags contains 'tactile'
        or product.tags contains 'clicky' %}
        <div class="product-card__tags">
          {% for tag in product.tags %}
            {% if tag == 'linear' or tag == 'tactile' or tag == 'clicky' %}
              <span class="product-tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </a>

  <!-- Quick Add -->
  {% unless product.tags contains 'configurator' %}
    <button
      class="product-card__quick-add btn btn--primary"
      data-product-id="{{ product.id }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      {% unless product.available %}disabled{% endunless %}
    >
      {% if product.available %}
        {{ 'products.add_to_cart' | t }}
      {% else %}
        {{ 'products.sold_out' | t }}
      {% endif %}
    </button>
  {% endunless %}
</article>