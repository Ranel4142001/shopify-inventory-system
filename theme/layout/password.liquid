<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>

  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}

  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-border: {{ settings.color_border }};
      --font-heading: {{ settings.font_heading.family }}, sans-serif;
      --font-body: {{ settings.font_body.family }}, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: linear-gradient(45deg, #0e0b2f 4%, #302b63 46%, #24243e 94%);
      background-attachment: fixed;
      color: var(--color-text);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    .password-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      background: rgba(23, 21, 48, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 2px solid var(--color-primary);
      box-shadow: 0 4px 20px rgba(0, 240, 255, 0.15);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .password-header__inner {
      width: 100%;
      max-width: var(--page-width, 1280px);
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .password-header__logo {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text);
      text-decoration: none;
    }

    .password-header__logo span {
      color: var(--color-primary);
    }

    .password-page {
      text-align: center;
      padding: 48px 32px;
      max-width: 480px;
      width: 100%;
      background: rgba(23, 21, 48, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      margin-top: 80px;
    }

    .password-page__logo {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 32px;
      display: block;
    }

    .password-page__logo span {
      color: var(--color-primary);
    }

    .password-page__title {
      font-family: var(--font-heading);
      font-size: 40px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 16px;
    }

    .password-page__subtitle {
      font-size: 16px;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-bottom: 40px;
    }

    .password-page__form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .password-page__input {
      width: 100%;
      padding: 14px 16px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: var(--color-text);
      font-size: 15px;
      font-family: var(--font-body);
      transition: border-color 0.2s;
    }

    .password-page__input:focus {
      outline: none;
      border-color: var(--color-primary);
    }

    .password-page__input::placeholder {
      color: var(--color-text-muted);
    }

    .password-page__btn {
      width: 100%;
      padding: 14px;
      background: var(--color-primary);
      color: #000;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      font-family: var(--font-body);
    }

    .password-page__btn:hover {
      background: #00cc77;
    }

    .password-page__footer {
      margin-top: 32px;
      font-size: 13px;
      color: var(--color-text-muted);
    }

    .password-page__footer a {
      color: var(--color-primary);
      text-decoration: none;
    }

    /* Animated background dots */
    .password-page__bg {
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
    }

    .password-page__dot {
      position: absolute;
      width: 2px;
      height: 2px;
      background: var(--color-primary);
      border-radius: 50%;
      opacity: 0.3;
      animation: twinkle 3s ease-in-out infinite;
    }
  </style>

  {{ content_for_header }}
</head>

<body>

  <!-- Animated background -->
  <div class="password-page__bg" aria-hidden="true">
    {% for i in (1..20) %}
      <div
        class="password-page__dot"
        style="
          top: {{ i | times: 5 }}%;
          left: {{ i | times: 7 | modulo: 100 }}%;
          animation-delay: {{ i | times: 0.3 }}s;
        "
      ></div>
    {% endfor %}
  </div>

  <header class="password-header">
    <div class="password-header__inner">
      <a href="/" class="password-header__logo">
        <span>Tactile</span> Lab
      </a>
    </div>
  </header>

  <div class="password-page">

    <!-- Heading -->
    <h1 class="password-page__title">
      Something<br>Precise<br>Is Coming
    </h1>

    <p class="password-page__subtitle">
      We're crafting something special for the mechanical keyboard community.
      Enter the password to get early access.
    </p>

    <!-- Password Form -->
    {% form 'storefront_password' %}
      <div class="password-page__form">
        <input
          type="password"
          name="password"
          class="password-page__input"
          placeholder="Enter password..."
          autocomplete="current-password"
          autofocus
        >
        {{ form.errors | default_errors }}
        <button type="submit" class="password-page__btn">
          Enter the Lab
        </button>
      </div>
    {% endform %}

    <p class="password-page__footer">
      Are you the store owner?
      <a href="/admin">Log in here</a>
    </p>

  </div>

  {{ content_for_layout }}

</body>
</html>