<footer class="footer">
  <div class="footer__inner container">

    <!-- Brand -->
    <div class="footer__brand">
      <div class="footer__brand-icon" style="margin-bottom: 12px; color: var(--color-primary); display: flex; justify-content: center; align-items: center; filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.3));">
        <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="4" />
          <rect x="7" y="7" width="10" height="10" rx="2" stroke-dasharray="2 1" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      </div>
      <a href="/" class="footer__logo">
        <span class="header__logo-accent">Tactile</span> Lab
      </a>
      <p class="footer__tagline">
        {{ section.settings.tagline | default: 'Precision engineered. Community driven.' }}
      </p>

      <!-- Social Links -->
      <div class="footer__social">
        {% if settings.social_twitter != blank %}
          <a href="{{ settings.social_twitter }}" class="footer__social-link" aria-label="Twitter" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_discord != blank %}
          <a href="{{ settings.social_discord }}" class="footer__social-link" aria-label="Discord" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.04.028.056a19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Newsletter -->
    <div class="footer__newsletter">
      <h3 class="footer__newsletter-title">
        {{ 'footer.newsletter_title' | t }}
      </h3>
      <p class="footer__newsletter-subtitle">
        {{ 'footer.newsletter_subtitle' | t }}
      </p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer__newsletter-form">
          <input
            type="email"
            name="contact[email]"
            class="footer__newsletter-input"
            placeholder="{{ 'footer.newsletter_placeholder' | t }}"
            required
            aria-label="Email address"
          >
          <button type="submit" class="btn btn--primary">
            {{ 'footer.newsletter_submit' | t }}
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Links -->
    <div class="footer__links">
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
          <div class="footer__link-group">
            <h4 class="footer__link-title">{{ block.settings.title }}</h4>
            <ul class="footer__link-list">
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}" class="footer__link">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>

  <!-- Centered Quick Links Menu -->
  <div class="footer__quick-nav" style="display: flex; justify-content: center; gap: 32px; padding: 24px 24px 16px; flex-wrap: wrap; border-top: 1px solid var(--color-border); max-width: var(--page-width); margin: 0 auto;">
    <a href="/" style="font-size: 13px; font-weight: 500; color: var(--color-text-muted); transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">Home</a>
    <a href="/collections/all" style="font-size: 13px; font-weight: 500; color: var(--color-text-muted); transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">Shop Keyboards</a>
    <a href="/collections/all" style="font-size: 13px; font-weight: 500; color: var(--color-text-muted); transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">Group Buys</a>
    <a href="/cart" style="font-size: 13px; font-weight: 500; color: var(--color-text-muted); transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">Shopping Cart</a>
    <a href="/policies/privacy-policy" style="font-size: 13px; font-weight: 500; color: var(--color-text-muted); transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'">Support Help</a>
  </div>

  <!-- Bottom Bar -->
  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {{ 'footer.rights' | t }}.
      </p>
      <div class="footer__bottom-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">Refund Policy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Precision engineered. Community driven."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link List",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}