<div class="collection-page">
  <div class="container">

    <!-- Collection Header -->
    <div class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-page__description">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>

    <!-- Toolbar -->
    <div class="collection-page__toolbar">
      <div class="collection-page__sort">
        <label for="sort-select" class="sr-only">Sort by</label>
        <select
          id="sort-select"
          class="filter-tag-select"
          onchange="window.location.href = this.value"
        >
          <option
            value="{{ collection.url }}"
            {% if collection.sort_by == blank or collection.sort_by == 'manual' %}selected{% endif %}
          >
            All
          </option>
          <option
            value="{{ collection.url }}?sort_by=best-selling"
            {% if collection.sort_by == 'best-selling' %}selected{% endif %}
          >
            Best selling
          </option>
          <option
            value="{{ collection.url }}?sort_by=price-ascending"
            {% if collection.sort_by == 'price-ascending' %}selected{% endif %}
          >
            Lowest to highest
          </option>
          <option
            value="{{ collection.url }}?sort_by=price-descending"
            {% if collection.sort_by == 'price-descending' %}selected{% endif %}
          >
            Highest to lowest
          </option>
          <option
            value="{{ collection.url }}?sort_by=created-descending"
            {% if collection.sort_by == 'created-descending' %}selected{% endif %}
          >
            Newest
          </option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    {% paginate collection.products by 12 %}
      {% if collection.products.size > 0 %}
        <div class="collection-page__grid">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="pagination__btn">
                &larr; Previous
              </a>
            {% endif %}

            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="pagination__page">
                  {{ part.title }}
                </a>
              {% elsif part.title == paginate.current_page %}
                <span class="pagination__page is-active">
                  {{ part.title }}
                </span>
              {% else %}
                <span class="pagination__ellipsis">{{ part.title }}</span>
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="pagination__btn">
                Next &rarr;
              </a>
            {% endif %}
          </div>
        {% endif %}

      {% else %}
        <div class="collection-page__empty">
          <p>{{ 'collection.no_products' | t }}</p>
          <a href="/collections/all" class="btn btn--primary">
            Browse All Products
          </a>
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}