<section class="hero" {% if section.settings.background_image != blank %}style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}')"{% endif %}>
  <div class="hero__overlay"></div>
  <div class="container hero__container">
    <div class="hero__inner">

      <!-- Label -->
      {% if section.settings.label != blank %}
        <span class="hero__label">
          <span class="hero__label-dot"></span>
          {{ section.settings.label }}
        </span>
      {% endif %}

      <!-- Heading -->
      <h1 class="hero__heading">
        {{ section.settings.heading | default: 'Engineer Your<br>Perfect Board' }}
      </h1>

      <!-- Subheading -->
      {% if section.settings.subheading != blank %}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <!-- Stats Bar -->
      <div class="hero__stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="hero__stat" {{ block.shopify_attributes }}>
              <span class="hero__stat-value">{{ block.settings.value }}</span>
              <span class="hero__stat-label">{{ block.settings.label }}</span>
            </div>
            {% unless forloop.last %}
              <div class="hero__stat-divider"></div>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>

      <!-- CTAs -->
      <div class="hero__ctas">
        {% if section.settings.cta_primary_label != blank %}
          <a
            href="{{ section.settings.cta_primary_url }}"
            class="btn btn--primary btn--lg"
          >
            {{ section.settings.cta_primary_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.cta_secondary_label != blank %}
          <a
            href="{{ section.settings.cta_secondary_url }}"
            class="btn btn--outline btn--lg"
          >
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>

      <!-- Scroll Indicator -->
      <div class="hero__scroll">
        <span>Scroll to explore</span>
        <div class="hero__scroll-line"></div>
      </div>

    </div>

    <!-- Right Side Keyboard Image -->
    <div class="hero__image-wrapper">
      <img
        src="{{ 'hero-keyboard.png' | asset_url }}"
        alt="Tactile Lab Premium Custom Mechanical Keyboard"
        class="hero__image"
        width="600"
        height="450"
        loading="eager"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Now Available — Limited Drop"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Engineer Your Perfect Board</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "High-end mechanical keyboards and desk accessories, built for those who demand precision."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary Button Label",
      "default": "Build Your Board"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary Button Label",
      "default": "View Group Buys"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary Button URL"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "10K+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Community Members"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "10K+",
            "label": "Community Members"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "50+",
            "label": "Group Buys Shipped"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "99%",
            "label": "Satisfaction Rate"
          }
        }
      ]
    }
  ]
}
{% endschema %}