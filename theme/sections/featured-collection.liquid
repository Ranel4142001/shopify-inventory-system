<section class="featured-collection">
  <div class="container">

    <!-- Header -->
    <div class="featured-collection__header">
      <div class="featured-collection__header-left">
        {% if section.settings.label != blank %}
          <span class="section-label">{{ section.settings.label }}</span>
        {% endif %}
        <h2 class="featured-collection__title">
          {{ section.settings.title | default: 'Featured Builds' }}
        </h2>
      </div>
      {% if section.settings.collection != blank %}
        <a
          href="{{ section.settings.collection.url }}"
          class="featured-collection__view-all btn btn--outline"
        >
          View All
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Filter Tabs -->
    <div class="featured-collection__tabs">
      <button class="tab-btn is-active" data-filter="all">All</button>
      <button class="tab-btn" data-filter="group-buy">Group Buys</button>
      <button class="tab-btn" data-filter="in-stock">In Stock</button>
      <button class="tab-btn" data-filter="new">New Arrivals</button>
    </div>

    <!-- Products Grid -->
    <div class="featured-collection__grid" id="featured-grid">
      {% assign collection = section.settings.collection %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.product_limit %}
          <div
            class="featured-collection__item"
            data-tags="{{ product.tags | join: ',' | downcase }}"
          >
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          {% case i %}
            {% when 1 %}
              {% assign p_title = 'TL-Carbon TKL' %}
              {% assign p_image = 'keyboard_carbon_tkl.png' %}
              {% assign p_price = '₱169.00' %}
              {% assign p_tags = 'group-buy' %}
            {% when 2 %}
              {% assign p_title = 'TL-Cosmos 75% Aluminum' %}
              {% assign p_image = 'keyboard_cosmos_75.png' %}
              {% assign p_price = '₱189.00' %}
              {% assign p_tags = 'group-buy,new' %}
            {% when 3 %}
              {% assign p_title = 'TL-Eclipse Pro 65%' %}
              {% assign p_image = 'keyboard_eclipse_65.png' %}
              {% assign p_price = '₱199.00' %}
              {% assign p_tags = 'group-buy' %}
            {% when 4 %}
              {% assign p_title = 'TL-Ember Switch Set (Linear)' %}
              {% assign p_image = 'keyboard_ember_switch.png' %}
              {% assign p_price = '₱29.00' %}
              {% assign p_tags = 'in-stock' %}
          {% endcase %}
          <div class="featured-collection__item" data-tags="{{ p_tags }}">
            <div class="product-card product-card--placeholder">
              <div class="product-card__image-wrapper">
                <img
                   src="{{ p_image | asset_url }}"
                   alt="{{ p_title }}"
                   class="product-card__image"
                   loading="lazy"
                   width="360"
                   height="360"
                   style="object-fit: cover;"
                >
              </div>
              <div class="product-card__info">
                <p class="product-card__vendor">Tactile Lab</p>
                <h3 class="product-card__title">{{ p_title }}</h3>
                <div class="price-wrapper">
                  <span class="price">{{ p_price }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>

<script>
  // Tab filtering
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const filter = btn.dataset.filter;
      document.querySelectorAll('.featured-collection__item').forEach(item => {
        if (filter === 'all') {
          item.style.display = 'block';
        } else {
          const tags = item.dataset.tags || '';
          if (filter === 'in-stock') {
            // In stock means it either explicitly has 'in-stock' tag, or is NOT a group-buy
            const isInStock = tags.includes('in-stock') || (!tags.includes('group-buy') && tags !== '');
            item.style.display = isInStock ? 'block' : 'none';
          } else {
            item.style.display = tags.includes(filter) ? 'block' : 'none';
          }
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Handpicked for You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Builds"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}